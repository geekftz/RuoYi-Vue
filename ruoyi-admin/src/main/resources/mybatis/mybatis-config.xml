<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!--
        【MyBatis全局配置文件】在 application.yml 的 mybatis.configLocation 中指定加载，
        由 MyBatisConfig.sqlSessionFactory() 装配进 SqlSessionFactory，对所有Mapper SQL生效。
    -->
    <!-- 全局参数 -->
    <settings>
        <!-- 使全局的映射器启用或禁用缓存（MyBatis二级缓存总开关；若依实体缓存主要走Redis，此项保持默认） -->
        <setting name="cacheEnabled"             value="true"   />
        <!-- 允许JDBC 支持自动生成主键（insert后可通过 useGeneratedKeys 把自增ID回填到实体对象，如新增用户后直接拿到userId） -->
        <setting name="useGeneratedKeys"         value="true"   />
        <!-- 配置默认的执行器.SIMPLE就是普通执行器;REUSE执行器会重用预处理语句(prepared statements);BATCH执行器将重用语句并执行批量更新 -->
        <setting name="defaultExecutorType"      value="SIMPLE" />
		<!-- 指定 MyBatis 所用日志的具体实现：SLF4J → 交给logback输出，SQL语句与参数会打到日志中便于调试 -->
        <setting name="logImpl"                  value="SLF4J"  />
        <!-- 使用驼峰命名法转换字段（若依XML中全部手写 resultMap 映射，故此处注释掉不启用） -->
		<!-- <setting name="mapUnderscoreToCamelCase" value="true"/> -->
	</settings>
	
</configuration>
